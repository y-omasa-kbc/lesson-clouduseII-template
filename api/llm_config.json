{
  "chat_model": "google/gemma-4-31b-it:free",
  "fallback_models": [
    "set-by-teacher/fallback-model:free"
  ],
  "structured_output_mode": "json_schema",
  "max_output_tokens": 400,
  "classify_max_output_tokens": 300,
  "max_classify_attempts": 3,
  "max_llm_calls_per_request": 5,
  "max_retries_per_model": 2,
  "retry_base_delay_seconds": 1,
  "retry_max_delay_seconds": 8,
  "retry_max_wait_seconds": 10,
  "cache_ttl_seconds": 86400,
  "max_job_items": 20,
  "history_token_budget": 1500,
  "max_history_messages": 40,
  "system_prompt": "あなたはカモメ物産（架空の会社）の社内問い合わせ窓口のアシスタントである。日本語で、簡潔に、丁寧に答える。分からないことは分からないと答える。"
}
